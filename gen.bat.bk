set WORKSPACE=.

set LUBAN_DLL=%WORKSPACE%\Tools\Luban\Luban.dll
set CONF_ROOT=%WORKSPACE%\DataTables
set CLIENT_ROOT=%WORKSPACE%\..\..\minigame

dotnet %LUBAN_DLL% ^
    -t all ^
    -c typescript-bin -c lua-lua^
    -d bin -d lua ^
    --conf %WORKSPACE%\luban.conf ^
    -x pathValidator.rootDir=%WORKSPACE%\Projects\Csharp_Unity_bin ^
    -x typescript-bin.outputCodeDir=%WORKSPACE%\output_client\code ^
    -x lua-lua.outputCodeDir=%WORKSPACE%\output_server\code ^
    -x bin.outputDataDir=%WORKSPACE%\output_client\data ^
    -x lua.outputDataDir=%WORKSPACE%\output_server\data ^
    -x bin.fileExt=bin ^
    -x codeStyle=none


@echo off
if exist "%CLIENT_ROOT%" (
    if exist "%CLIENT_ROOT%\bin\config\bin" (
        del /Q "%CLIENT_ROOT%\bin\config\bin\*.*"
    )
    REM 检查目标目录是否存在，若不存在则尝试创建
    if not exist "%CLIENT_ROOT%\bin\config\bin\" (
        echo 正在创建目标目录 "%CLIENT_ROOT%\bin\config\bin\"...
        mkdir "%CLIENT_ROOT%\bin\config\bin\"
        if errorlevel 1 (
            echo 错误：无法创建目标目录！
            pause
            exit /b 1
        )
    )
    REM 使用xcopy复制文件（保留目录结构）
    REM xcopy "%WORKSPACE%\output_client\data\*" "%CLIENT_ROOT%\bin\config\bin\" /Y /E /I /Q
	REM del "%WORKSPACE%\output_client\data\ai.bin"
	if exist "%CLIENT_ROOT%\bin\config\configbin.zip" (
		del "%CLIENT_ROOT%\bin\config\configbin.zip"
    )
    WinRAR.exe a -afzip -r -ep1 -m5 -idq "%CLIENT_ROOT%\bin\config\configbin.zip" "%WORKSPACE%\output_client\data\" -x"%WORKSPACE%\output_client\data\ai.bin"
    REM 检查复制结果
    if errorlevel 1 (
        echo 错误：文件复制过程中发生问题！
        pause
        exit /b 1
    ) else (
        echo 文件已成功复制到目标目录！
    )
    
    xcopy "%WORKSPACE%\output_client\code\*" "%CLIENT_ROOT%\src\schema\" /Y /E /I /Q
)

setlocal enabledelayedexpansion

REM 修正1：检查目录是否存在
if not exist "%WORKSPACE%\output_server\data\" (
    echo 错误：目录 "%WORKSPACE%\output_server\data\" 不存在！
    pause
    exit /b 1
)

REM 修正2：进入目录并检查是否成功
cd /d "%WORKSPACE%\output_server\data" 2>nul || (
    echo 无法进入目录 "%WORKSPACE%\output_server\data"
    pause
    exit /b 1
)

REM 修正3：遍历文件并添加重命名条件
for %%f in (*.lua) do (
    set "original_file=%%f"
    set "filename=%%~nf"

    REM 仅当原文件名不以 "config_" 开头时才重命名（避免重复处理）
    if /i "!filename:~0,7!" neq "config_" (
        echo 正在重命名: %%f → config_!filename!.lua
        ren "%%f" "config_!filename!.lua"
    ) else (
        echo 跳过已处理文件: %%f
    )
)


pause